{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $AI_MEMORY_PLUGIN_ROOT/hooks/scripts/session-start.py",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $AI_MEMORY_PLUGIN_ROOT/hooks/scripts/session-reminder.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $AI_MEMORY_PLUGIN_ROOT/hooks/scripts/session-sync.py",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "read_file|write_file|edit_file|replace_file|run_shell_command|create_directory|list_directory|move_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $AI_MEMORY_PLUGIN_ROOT/hooks/scripts/session-pretool-reminder.py",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
